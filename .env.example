# Copie para .env e ajuste. O arquivo .env NAO deve ir para o Git.

# Banco de dados
DB_URL=jdbc:mysql://localhost:3306/lojacarro?serverTimezone=America/Fortaleza
DB_USERNAME=lojacarro
DB_PASSWORD=troque-esta-senha
MYSQL_ROOT_PASSWORD=troque-esta-senha-root

# Segurança (JWT_SECRET: no mínimo 32 caracteres aleatórios)
JWT_SECRET=gere-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRACAO_MINUTOS=120

# Administrador criado na primeira inicialização
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@lojacarro.local
ADMIN_SENHA=troque-esta-senha

# Frontend autorizado no CORS (separe por vírgula)
CORS_ORIGINS=http://localhost:4200

# Pasta das fotografias dos veículos
IMAGENS_DIR=img

# RabbitMQ (microserviço de logs)
RABBITMQ_USERNAME=lojacarro
RABBITMQ_PASSWORD=troque-esta-senha

# Microservico de logs
LOGS_URL=http://localhost:8081
LOGS_DB_URL=jdbc:mysql://localhost:3306/lojacarro_logs?serverTimezone=America/Fortaleza
LOGS_API_KEY=gere-uma-chave-aleatoria-com-pelo-menos-16-caracteres
