# Variáveis para docker-compose.prod.yml. Copie para .env e TROQUE TODAS AS SENHAS.
# Dica para gerar valores aleatórios:  openssl rand -base64 32

# Banco de dados (MySQL)
DB_USERNAME=lojacarro
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# JWT (mínimo de 32 caracteres)
JWT_SECRET=
JWT_EXPIRACAO_MINUTOS=120

# Administrador criado na primeira inicialização
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@lojacarro.local
ADMIN_SENHA=

# Cliente de demonstração para a apresentação (deixe vazio para não criar)
DEMO_CLIENTE_EMAIL=cliente@lojacarro.local
DEMO_CLIENTE_SENHA=

# RabbitMQ
RABBITMQ_USERNAME=lojacarro
RABBITMQ_PASSWORD=

# Chave da comunicação interna entre a API e o microserviço de logs (mínimo de 16 caracteres)
LOGS_API_KEY=

# Endereço público do site (ex.: http://54.123.45.67) e porta do Nginx
CORS_ORIGINS=http://localhost
WEB_PORTA=80

# Swagger em /swagger-ui.html (true ou false)
SWAGGER_ENABLED=true
